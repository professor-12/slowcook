# Testnet only. Copy to .env and fill in. Keys are NOT stored here: the scripts read them from the
# near-cli legacy keychain (~/.near-credentials/testnet/<account>.json) or .demo-keys/ (git-ignored).
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com
# Account the factory is deployed on (token accounts become <symbol>-<id>.<this>)
SLOWCOOK_FACTORY=your-factory.testnet
# Account that creates the demo launch (pays ~2 NEAR for the token account)
SLOWCOOK_CREATOR=your-creator.testnet
# Account that funds the throwaway bidder wallets (sub-accounts) for the demo
SLOWCOOK_FUNDER=your-funder.testnet
# Demo timings (seconds)
DEMO_COMMIT_SECS=90
DEMO_REVEAL_SECS=90
DEMO_BIDDERS=12
